FROM hub.wpyun.com/khfw/ubuntu-zh:22.04
LABEL org.opencontainers.image.source="https://github.com/luvpepsi/docker-file/blob/main/open_jdk_jre11"
LABEL org.opencontainers.image.authors="luvpepsi"
LABEL org.opencontainers.image.version="11.0.25"
LABEL org.opencontainers.image.description="OpenJDK 11 JRE runtime on Ubuntu 22.04"

ENV JAVA_HOME=/opt/java
ENV PATH="${JAVA_HOME}/bin:${PATH}"
RUN chown -R 10001:10001 /opt && \
    mkdir -p /usr/share/fonts/truetype/custom && \
    apt-get update && \
    apt-get install -y --no-install-recommends fontconfig && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* 
COPY --chown=10001:10001 java /opt/java
COPY chinese/* /usr/share/fonts/truetype/custom/
RUN fc-cache -fv
