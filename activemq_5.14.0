FROM hub.wpyun.com/khfw/openjdk:jre-11

# 镜像信息
LABEL org.opencontainers.image.source="https://github.com/luvpepsi/docker-file/blob/main/activemq_5.14.0"
LABEL org.opencontainers.image.authors="luvpepsi"
LABEL org.opencontainers.image.version="5.14.0"
LABEL org.opencontainers.image.description="activemq_5.14.0 OpenJDK 11 JRE runtime on Ubuntu 22.04"

ARG ACTIVEMQ_UID=10001
ARG ACTIVEMQ_GID=10001

ENV ACTIVEMQ_HOME=/opt/activemq

# 拷贝本地的配置过的二进制包
COPY --chown=10001:10001 activemq/ ${ACTIVEMQ_HOME}/

# 权限赋予
RUN groupadd -g $ACTIVEMQ_GID activemq && \
    useradd -m -u $ACTIVEMQ_UID -g $ACTIVEMQ_GID activemq && \
    rm -rf /home/activemq

USER activemq

WORKDIR ${ACTIVEMQ_HOME}

EXPOSE 61616 8161 9404

ENV ACTIVEMQ_OPTS_MEMORY="-Xms256M -Xmx1G"
ENV ACTIVEMQ_OPTS="-Djava.util.logging.config.file=logging.properties \
-Djava.security.auth.login.config=/opt/activemq/conf/login.config \
-javaagent:/opt/activemq/agent/jmx_prometheus_javaagent-0.20.0.jar=9404:/opt/activemq/agent/config.yaml"


CMD ["/opt/activemq/bin/activemq", "console"]
