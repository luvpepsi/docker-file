FROM hub.wpyun.com/khfw/jre:21
ARG APP_UID=10001
ARG APP_GID=10001
RUN groupadd -g $APP_GID app && \
    useradd -u $APP_UID -g $APP_GID -s /sbin/nologin -m app && \
    mkdir -p /opt/app && \
    chown -R app:app /opt/app
WORKDIR /opt/app

# 复制 JAR 并赋权限
COPY --chown=10001:10001 app.jar .

USER app

ENTRYPOINT ["java"]
