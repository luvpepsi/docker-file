FROM hub.wpyun.com/khfw/ubuntu:22.04
LABEL org.opencontainers.image.source="https://github.com/luvpepsi/docker-file/blob/main/ubuntu22.04_cn"
LABEL org.opencontainers.image.authors="luvpepsi"
LABEL org.opencontainers.image.version="22.04"
LABEL org.opencontainers.image.description="Chinese Env on Ubuntu 22.04"

ENV DEBIAN_FRONTEND=noninteractive TZ=Asia/Shanghai

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    sed -i 's|archive.ubuntu.com|mirrors.aliyun.com|g' /etc/apt/sources.list && \
    sed -i 's|security.ubuntu.com|mirrors.aliyun.com|g' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends tzdata locales && \
    locale-gen zh_CN.UTF-8 && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV LANG=zh_CN.UTF-8 LANGUAGE=zh_CN:zh LC_ALL=zh_CN.UTF-8

CMD ["/bin/bash"]
